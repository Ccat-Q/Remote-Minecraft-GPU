From: RemoteGPU <noreply@example.invalid>
Subject: [PATCH] virgl/vtest: opt into RemoteGPU legacy transport

RemoteGPU transports vtest across QUIC and cannot pass SCM_RIGHTS file
descriptors or mmap-backed resources. Let deployments explicitly retain the
protocol-0 resource and inline-transfer path.

diff --git a/src/gallium/winsys/virgl/vtest/virgl_vtest_socket.c b/src/gallium/winsys/virgl/vtest/virgl_vtest_socket.c
index a74b4c69daf..83822af4f9c 100644
--- a/src/gallium/winsys/virgl/vtest/virgl_vtest_socket.c
+++ b/src/gallium/winsys/virgl/vtest/virgl_vtest_socket.c
@@ -220,6 +220,14 @@ int virgl_vtest_connect(struct virgl_vtest_winsys *vws)
 
   vws->sock_fd = sock;
   virgl_vtest_send_init(vws);
+
+   /* RemoteGPU serializes this protocol over QUIC. Protocol >= 2 uses
+    * mmap-able resources and Unix FD passing, neither of which crosses a
+    * network connection. Keep the established protocol-0 inline path. */
+   if (os_get_option("REMOTEGPU_VTEST_LEGACY")) {
+      vws->protocol_version = 0;
+      return 0;
+   }
   vws->protocol_version = virgl_vtest_negotiate_version(vws, VTEST_PROTOCOL_VERSION);
 
   /* Version 1 is deprecated. */
